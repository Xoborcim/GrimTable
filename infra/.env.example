# Copy to infra/.env (ignored by git). Generate at least 32 random bytes.
TURN_SHARED_SECRET=change_me
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=turn.example.com
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_TTL_SECONDS=7200
ROOM_TTL_SECONDS=1800
MATCH_TTL_SECONDS=43200
METRICS_ENABLED=false
# VPS local interface used for relays. Empty derives from external IP/mapping.
TURN_LISTENING_IP=0.0.0.0
TURN_RELAY_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49260
# For TURN TLS, mount certs with docker-compose.tls.yml and configure turns: URL.
TURN_TLS=false
